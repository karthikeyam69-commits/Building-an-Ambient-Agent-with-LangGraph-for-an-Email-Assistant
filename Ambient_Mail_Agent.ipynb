3. Load and Parse Emails
We convert the raw text "message" column into structured data (Sender, Subject, etc.).

Python
import pandas as pd
import re

# Load the CSV
csv_path = "/content/drive/MyDrive/Colab Notebooks/Project/emails.csv"
df = pd.read_csv(csv_path)

def parse_email(raw_text):
    headers = {}
    # Use splitlines() for cleaner iteration
    for line in raw_text.split("\n"):
        if line.startswith("Message-ID:"):
            headers["Message-ID"] = line.replace("Message-ID:", "").strip()
        elif line.startswith("From:"):
            headers["From"] = line.replace("From:", "").strip()
        elif line.startswith("Subject:"):
            headers["Subject"] = line.replace("Subject:", "").strip()
    return headers

# Apply parsing and expand to a new DataFrame
parsed = df["message"].apply(parse_email)
parsed_df = pd.DataFrame(parsed.tolist())

print("Dataset loaded and parsed successfully!")
print(parsed_df.head())
4. Categorization and Agent Logic
This mimics an "Agent" deciding what to do with each email based on the subject line.

Python
def categorize(subject):
    if subject is None or (isinstance(subject, float) and pd.isna(subject)):
        return "Unknown"
    
    subject = subject.lower()
    if "meeting" in subject or "schedule" in subject:
        return "Work"
    elif "invoice" in subject or "payment" in subject:
        return "Finance"
    elif "party" in subject or "invitation" in subject:
        return "Personal"
    else:
        return "Other"

def agent_action(row):
    if row["Category"] == "Work":
        return "Add to calendar / notify team"
    elif row["Category"] == "Finance":
        return "Forward to accounts department"
    elif row["Category"] == "Personal":
        return "Mark as personal / no action"
    else:
        return "Archive"

# Apply logic
parsed_df["Category"] = parsed_df["Subject"].apply(categorize)
parsed_df["Agent_Action"] = parsed_df.apply(agent_action, axis=1)

# Save the final result
output_path = "/content/drive/MyDrive/Colab Notebooks/Project/final_email_assistant.csv"
parsed_df.to_csv(output_path, index=False)

print(f"Final assistant dataset saved to: {output_path}")
5. Visualize Results
A quick pie chart to see how your "Agent" is distributing its workload.

Python
import matplotlib.pyplot as plt

action_counts = parsed_df['Agent_Action'].value_counts()
explode = [0.05] * len(action_counts)  # Separate all slices slightly

plt.figure(figsize=(7, 7))
action_counts.plot(
    kind="pie",
    autopct="%1.1f%%",
    startangle=90,
    explode=explode
)

plt.title("Agent Actions Distribution")
plt.ylabel("")  # Hide the y-label for aesthetics
plt.show()
